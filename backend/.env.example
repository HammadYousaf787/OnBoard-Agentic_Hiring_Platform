ENVIRONMENT=development

# Postgres
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<db_name>
SYNC_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<db_name>

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=<access_key>
MINIO_SECRET_KEY=<secret_key>
MINIO_SECURE=False
MINIO_BUCKET=candidate-cvs

# Auth
JWT_SECRET_KEY=<generate a long random string>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
FRONTEND_ORIGIN=http://localhost:3000
APPLY_PORTAL_ORIGIN=http://localhost:3001

# AI review pipeline
GEMINI_API_KEY=<google ai studio / gemini api key>
GEMINI_MODEL=gemini-flash-latest
GITHUB_TOKEN=<optional: personal access token, raises rate limit from 60/hr to 5000/hr>
BRIGHTDATA_API_TOKEN=<bright data api token, required for LinkedIn scraping>

